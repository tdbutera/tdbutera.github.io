# Cloudflare Workers static assets publish EVERYTHING under assets.directory (".")
# unless listed here. Nothing is excluded by default.
# Verified: developers.cloudflare.com/workers/static-assets/binding/ 2026-09-15.

# Blanket rule first. Tooling creates new dot-directories at deploy time, so
# enumerating them one by one loses the race. .wrangler/ was created BY the
# 2026-09-15 deploy and published the Cloudflare account id before this line existed.
.*
.*/**

# Re-include the one dot-path a site legitimately serves
!.well-known
!.well-known/**

# Named explicitly as well, so the intent survives an edit to the blanket rule
.git
.git/**
.git_stale_*
.git_stale_*/**
.wrangler
.wrangler/**

# Worker source and deploy config, not client-side assets
wrangler.jsonc
wrangler.toml
workers
workers/**
node_modules
node_modules/**
package.json
package-lock.json

# Superseded copies of live pages are never published
_ReviewForDelete
_ReviewForDelete/**
*.bak
